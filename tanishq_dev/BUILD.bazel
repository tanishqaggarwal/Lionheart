load("@platformio_rules//platformio:platformio.bzl", "platformio_project", "platformio_library")

platformio_project(
    name = "rover_control",
    src = "rover_control.cc",
    board = "teensy41",
    framework = "arduino",
    platform = "teensy",
)

cc_library(
    name = "dynamics",
    srcs = ["dynamics.cc"],
    deps = [":linalg"]
)

cc_library(
    name = "linalg",
    hdrs = ["linalg.h"],
)

cc_library(
    name = "cfd_lib",
    hdrs = ["cfd_lib.h", "cfd_lib_impl.h"],
    deps = [":linalg"]
)

cc_binary(
    name = "cfd",
    srcs = ["cfd.cc"],
    deps = [":stl_reader", ":cfd_lib", ":linalg"]
)

cc_library(
    name = "stl_reader",
    hdrs = ["stl_reader.h"]
)

cc_library(
    name = "controller",
    hdrs = ["controller.h"],
    srcs = ["controller.cc"],
    deps = [":linalg"]
)